# ─── Base de Datos ───
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=tu_password_seguro
DB_NAME=tracking_app
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ─── JWT (usa valores largos y DIFERENTES) ───
JWT_SECRET=genera-un-secret-aleatorio-de-32-caracteres-minimo
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=genera-OTRO-secret-aleatorio-diferente-al-anterior
JWT_REFRESH_EXPIRES_IN=7d

# ─── Admin seed ───
SEED_ADMIN=true
SEED_ROLES=true
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASS=CambiaEstaContraseña123!

# ─── CORS (lista de orígenes separados por coma) ───
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
PUBLIC_FORM_RATE_LIMIT=5

# ─── SMTP (correo) ───
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_email@tudominio.com
SMTP_PASS=tu_password_smtp

# ─── AWS S3 ───
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
AWS_S3_BUCKET=tu-bucket
AWS_REGION=us-east-1

# ─── Google OAuth ───
GMAIL_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=tu_client_secret

# ─── API de integración externa ───
INTEGRACION_API_KEY=genera-una-api-key-segura-de-64-caracteres

# ─── Anthropic (parser IA) ───
ANTHROPIC_API_KEY=sk-ant-...

# ─── Sync/Debug ───
SYNC_DB=true
DEBUG_TRANSITIONS=false
ROLES_DEFAULT=TRABAJADOR,RRHH,ADMIN,ADC,JefeRRHH
