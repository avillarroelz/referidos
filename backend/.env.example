# ─── Servidor ───
NODE_ENV=development
PORT=4000

# ─── Base de Datos (PostgreSQL) ───
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=tu_password_seguro
DB_NAME=tracking_app
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# (opcional) ruta al bundle CA de RDS para producción:
# DB_SSL_CA=./certs/rds-combined-ca-bundle.pem

# ─── JWT (genera con: openssl rand -hex 32) ───
JWT_SECRET=genera-un-secret-aleatorio-de-64-hex-minimo
JWT_EXPIRES_IN=20m
JWT_REFRESH_SECRET=genera-OTRO-secret-DIFERENTE-al-anterior
JWT_REFRESH_EXPIRES_IN=7d

# ─── Admin / Roles sembrados ───
SEED_ADMIN=true
SEED_ROLES=true
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASS=CambiaEstaContraseña123!
ROLES_DEFAULT=TRABAJADOR,RRHH,ADMIN,ADC,JefeRRHH,EXTERNO
ADMIN_ROLE=ADMIN

# ─── Dominio interno (para asignar rol por dominio del correo) ───
# @ecora.cl -> TRABAJADOR, cualquier otro -> EXTERNO
INTERNAL_EMAIL_DOMAIN=ecora.cl

# ─── CORS (lista de orígenes separados por coma) ───
CORS_ORIGIN=http://localhost:51842,http://localhost:5173

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
PUBLIC_FORM_RATE_LIMIT=5

# ─── SMTP clásico (fallback si no usas OAuth2) ───
# Puerto 587 + SMTP_SECURE=false → STARTTLS
# Puerto 465 + SMTP_SECURE=true  → SSL implícito
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tracking Referidos" <no-reply@tudominio.com>
RRHH_INBOX=rrhh@tudominio.com

# ─── SMTP OAuth2 (recomendado para Gmail/Workspace sin App Password) ───
# Si SMTP_OAUTH_REFRESH_TOKEN está definido, se usa OAuth2.
# Obtén el refresh token con: node src/scripts/getSmtpRefreshToken.js
SMTP_OAUTH_USER=no-reply@tudominio.com
SMTP_OAUTH_REFRESH_TOKEN=

# ─── AWS S3 (almacenamiento de CVs y adjuntos) ───
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
AWS_BUCKET=tu-bucket
AWS_REGION=us-east-1

# ─── Google OAuth (login con Google + Gmail API) ───
# Crea las credenciales en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Las credenciales de Gmail pueden ser las mismas:
GMAIL_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=tu_client_secret
GMAIL_REDIRECT_URI=http://localhost:4000/api/gmail/oauth2callback
GMAIL_SYNC_EMAIL=reclutamiento@tudominio.com
GMAIL_SYNC_REFRESH_TOKEN=

# ─── Anthropic (parser IA para correos de referidos) ───
ANTHROPIC_API_KEY=sk-ant-...

# ─── API de integración externa ───
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INTEGRACION_API_KEY=genera-una-api-key-segura-de-64-caracteres

# ─── Debug / Helpers ───
SYNC_DB=false
DEBUG_TRANSITIONS=false
DB_LOG=time
DEBUG_REFERIDOS=false
