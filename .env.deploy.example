# Plantilla del archivo de secretos de despliegue en la EC2.
# En la EC2 este archivo va como ./backend.env (lo referencia docker-compose: env_file: backend.env).
# Además se crea un ./.env MÍNIMO solo para la interpolación de compose, con:
#   ECR_REGISTRY=407024121863.dkr.ecr.sa-east-1.amazonaws.com
#   TAG=latest
# NO versionar el archivo real con secretos.
# Nota: SMTP_FROM debe ir SIN "Nombre <correo>" (el parser de env_file rechaza '<'); usar solo el correo.

# --- Entorno ---
NODE_ENV=production
PORT=8080
CORS_ORIGIN=https://referidos.ecoraapp.com

# --- Base de datos (RDS, BD de pruebas aislada) ---
DB_HOST=database-test.chdmwih4unji.sa-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASS=__SECRETO__
DB_NAME=referidos_test
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
# En NODE_ENV=production el código valida el cert de RDS: montar el CA y apuntar aquí
DB_SSL_CA=/app/certs/rds-ca.pem

# Primer arranque: true (crea/alinea tablas). Luego cambiar a false.
SYNC_DB=true
SEED_ROLES=true
SEED_ADMIN=true
ADMIN_EMAIL=admin@ecora.cl
ADMIN_PASS=__SECRETO__
ROLES_DEFAULT=TRABAJADOR,RRHH,ADMIN,ADC,JefeRRHH,EXTERNO
ADMIN_ROLE=ADMIN
INTERNAL_EMAIL_DOMAIN=ecora.cl

# --- JWT (usar secretos fuertes y distintos) ---
JWT_SECRET=__SECRETO__
JWT_REFRESH_SECRET=__SECRETO__
JWT_EXPIRES_IN=20m
JWT_REFRESH_EXPIRES_IN=7d

# --- S3 (bucket nuevo de pruebas) ---
AWS_ACCESS_KEY_ID=__SECRETO__
AWS_SECRET_ACCESS_KEY=__SECRETO__
AWS_REGION=sa-east-1
AWS_BUCKET=ecora-referidos-test

# --- Correo / OAuth / IA (copiar del .env local) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=__SECRETO__
SMTP_PASS=__SECRETO__
SMTP_FROM=no-reply@ecora.cl
GMAIL_CLIENT_ID=__SECRETO__
GMAIL_CLIENT_SECRET=__SECRETO__
GMAIL_REDIRECT_URI=https://referidos.ecoraapp.com/api/gmail/oauth2callback
# Secreto de Secrets Manager donde vive el refresh token de la casilla de sincronizacion
GMAIL_TOKEN_SECRET_NAME=referidos/gmail-sync
GOOGLE_CLIENT_ID=__SECRETO__
GOOGLE_CLIENT_SECRET=__SECRETO__
GOOGLE_REDIRECT_URI=https://referidos.ecoraapp.com/api/auth/google/callback
ANTHROPIC_API_KEY=__SECRETO__
INTEGRACION_API_KEY=__SECRETO__
